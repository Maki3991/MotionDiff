[Unit]
Description=MotionDiff video movement comparison
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=motiondiff
Group=motiondiff
WorkingDirectory=/opt/motiondiff
EnvironmentFile=/etc/motiondiff/ai.env
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MOTIONDIFF_RUN_IDLE_TTL_SECONDS=1800
Environment=MOTIONDIFF_MAX_ALIGNMENT_CELLS=810000
ExecStartPre=/usr/bin/install -d -m 700 /dev/shm/motiondiff-runs
ExecStart=/usr/bin/env MOTIONDIFF_RUNS_DIR=/dev/shm/motiondiff-runs /opt/motiondiff/.venv/bin/python app.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
CPUQuota=100%
MemoryHigh=750M
MemoryMax=900M
Nice=10
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev/shm
UMask=0077

[Install]
WantedBy=multi-user.target
