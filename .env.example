# MotionDiff AI feedback configuration.
# Copy this file to .env and fill the values supplied by the hackathon.

# Secret used only by the server. Never put this value in static/ or browser code.
AI_API_KEY=

# The provider endpoint. Use the complete API base URL required by the provider.
# Example shape only: https://api.example.com/v1
AI_API_BASE_URL=

# Model name supplied by the provider or hackathon.
AI_MODEL=

# Keep false until the endpoint and model have been verified locally.
AI_ENABLED=false

# Bounds for one report-generation request.
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1200

# One-shot run data. On Linux use the RAM-backed tmpfs explicitly.
# Do not point this at a persistent VPS directory.
MOTIONDIFF_RUNS_DIR=/dev/shm/motiondiff-runs
# Idle cleanup fallback for abandoned tabs (seconds).
MOTIONDIFF_RUN_IDLE_TTL_SECONDS=1800
